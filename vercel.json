{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "version": 2,
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.8.0"
        }
    },
    "routes": [
        {
            "src": "^/(build/.*)$",
            "dest": "/$1",
            "check": true
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}
